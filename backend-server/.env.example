STOCKSFEED_BASE_URL=https://stockfeedai-server-283151671335.us-central1.run.app

# riskripple trickle-down investigation agent
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_REGION=us-east-1
# RISKRIPPLE_FIXTURES_DIR=   # optional override; defaults to backend-server/data/fixtures

# Semantic retrieval (summarize_event_evidence). Defaults in code to the verified
# hackathon Knowledge Base id (SSYDB0BFCH, us-east-1) if unset -- override here to
# point at a different KB, or set to "" to force the local TF-IDF fallback (offline
# dev/tests, no AWS dependency).
# RISKRIPPLE_KNOWLEDGE_BASE_ID=
# RISKRIPPLE_KB_REGION=   # defaults to BEDROCK_REGION, then us-east-1

# Required by POST /riskripple/alerts/scan (reads real per-user portfolios to check
# regulatory/sanctions documents against). Same Aurora Postgres instance and values
# as frontend-dashboard/.env.example's DATABASE_* vars -- this is a separate Python
# process, so it needs its own copy of the same connection info, not a shared pool.
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_CA_CERT=
