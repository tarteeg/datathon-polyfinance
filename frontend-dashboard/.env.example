# Copy to .env.local. Never commit real credentials.
BETTER_AUTH_URL=http://localhost:3000


# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Aurora PostgreSQL writer endpoint, without a protocol or port.
DATABASE_HOST=
DATABASE_PORT=5432
# Existing PostgreSQL database, not the Aurora cluster identifier.
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
# AWS RDS CA PEM bundle. Multiline quoted PEM or literal \n separators are supported.
DATABASE_CA_CERT=

# FastAPI origin used by the Next.js server for stock data.
BACKEND_API_URL=http://127.0.0.1:8000
